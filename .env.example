NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=inference-gateway
SERVICE_VERSION=0.1.0
MAX_REQUEST_BYTES=1048576
GATEWAY_API_KEY=local-dev-gateway-key
PRIMARY_PROVIDER_KIND=mock
PRIMARY_PROVIDER_ID=mock
PRIMARY_MOCK_BEHAVIOR=success
PRIMARY_MOCK_DELAY_MS=0
SECONDARY_PROVIDER_KIND=
SECONDARY_PROVIDER_ID=
SECONDARY_MOCK_BEHAVIOR=success
SECONDARY_MOCK_DELAY_MS=0
PROVIDER_TIMEOUT_MS=1000
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BACKOFF_MS=50

# Legacy Milestone 1 compatibility settings for a primary real_stub provider.
PROVIDER_KIND=mock
REAL_PROVIDER_NAME=openai
REAL_PROVIDER_BASE_URL=https://api.example.com/v1

EVAL_WORKER_NAME=eval-worker
